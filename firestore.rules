rules_version = '2';

// Reglas de Firestore para AppHome.
// Estructura de datos:
//   familias/{familyId}/miembros/{dni}
//   familias/{familyId}/propiedades/{alias}
//   familias/{familyId}/gestion/datos
// El familyId se construye con el email del usuario cambiando "." por "_"
// (ver UsuarioProvider.updateUserInfo).
service cloud.firestore {
  match /databases/{database}/documents {

    function emailAsFamilyId() {
      return request.auth.token.email.replace('\\.', '_');
    }

    function belongsToFamily(familyId) {
      return request.auth != null
        && (familyId == request.auth.uid || familyId == emailAsFamilyId());
    }

    // Datos actuales
    match /familias/{familyId}/{document=**} {
      allow read, write: if belongsToFamily(familyId);
    }

    // Ruta antigua: solo se usa para la migración inicial a "familias".
    match /usuarios/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás queda cerrado por defecto.
  }
}
